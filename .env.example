# Server-side only. Never expose these values in browser code or committed files.
GROQ_API_KEY=
GROQ_API_KEYS=[]

# Stable primary secret for all new open-world and tactical saves.
# Use at least 32 random characters/bytes and keep it stable across deployments.
DND_SESSION_SECRET=
# Optional JSON array or comma-separated list of prior explicit signing secrets retained
# only long enough to verify saves created before a planned secret rotation.
DND_SESSION_SECRET_PREVIOUS=[]

# Optional provider model overrides.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
