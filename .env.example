# Server-side only. Never expose these values in browser code or committed files.
GROQ_API_KEY=
GROQ_API_KEYS=[]

# Required for open-world and tactical saves. Keep this stable across deployments.
# Use at least 32 random characters/bytes and rotate only with an explicit migration plan.
DND_SESSION_SECRET=

# Optional provider model overrides.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
